{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/integrationsiteanalysis/master/assets/schema_input.json",
    "title": "nf-core/integrationsiteanalysis YAML samplesheet",
    "description": "Per-sample long reads and optional analysis overrides for integration-site analysis.",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample id must be provided and cannot contain spaces",
                "meta": "id"
            },
            "reads": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fq|fastq)(\\.gz)?$",
                "errorMessage": "Long reads must be provided, cannot contain spaces, and must be .fq/.fastq (optionally gzipped)"
            },
            "reference": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa|fasta|fna)(\\.gz)?$",
                "errorMessage": "Optional per-sample reference genome (overrides --reference); must be .fa/.fasta/.fna (optionally gzipped)",
                "meta": "reference"
            },
            "blast_queries": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Optional per-sample BLAST query path (directory or file glob, overrides --blast_queries)",
                "meta": "blast_queries"
            },
            "plasmid": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(gb|gbk|dna)$",
                "errorMessage": "Optional per-sample plasmid GenBank (.gb/.gbk) or SnapGene (.dna) file (overrides --plasmid)",
                "meta": "plasmid"
            },
            "primary": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa|fasta|fna)(\\.gz)?$",
                "errorMessage": "Optional per-sample primary assembly; must be .fa/.fasta/.fna (optionally gzipped). Provide both primary and alternate, or neither.",
                "meta": "primary"
            },
            "alternate": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa|fasta|fna)(\\.gz)?$",
                "errorMessage": "Optional per-sample alternate assembly; must be .fa/.fasta/.fna (optionally gzipped). Provide both primary and alternate, or neither.",
                "meta": "alternate"
            },
            "purge": {
                "type": "boolean",
                "errorMessage": "Optional per-sample toggle for purge_dups (overrides --run_purging)",
                "meta": "purge"
            },
            "target_coverage": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "Optional per-sample downsampling target coverage (overrides --target_coverage)",
                "meta": "target_coverage"
            },
            "busco_lineage": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Optional per-sample BUSCO lineage (overrides --busco_lineage)",
                "meta": "busco_lineage"
            }
        },
        "required": ["id", "reads"]
    },
    "uniqueEntries": ["id"]
}
