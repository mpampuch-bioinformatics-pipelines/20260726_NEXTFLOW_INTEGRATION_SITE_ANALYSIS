/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Publishing is handled exclusively by the workflow `output {}` block in main.nf.
    Process publishDir is deprecated and intentionally omitted here.
*/

process {

    // ---- Read QC ----------------------------------------------------------
    withName: 'FASTK_FASTK' {
        ext.args = '-k31'
    }

    withName: '.*:READ_QC:FASTK_HISTEX' {
        ext.prefix = { "${meta.id}" }
        ext.args   = "-G"
        tag        = { "${meta.id}" }
    }

    withName: '.*:READ_QC:GENOMESCOPE2' {
        ext.prefix = { "${meta.id}" }
        ext.args   = {
            [
                "-k31",
                "--json_report"
            ].join(" ")
        }
    }

    // ---- Assembly ---------------------------------------------------------
    withName: 'HIFIASM' {
        ext.args = '--primary'
    }

    // ---- Assembly QC ------------------------------------------------------
    withName: 'ASMSTATS' {
        ext.prefix = { "${meta.id}_${meta.stage}_${meta.assembly}" }
    }
    withName: 'GFASTATS' {
        ext.prefix = { "${meta.id}_${meta.stage}_${meta.assembly}" }
    }
    withName: 'BUSCO_BUSCO' {
        ext.prefix = { "${meta.id}_${meta.stage}_${meta.assembly}" }
    }
    withName: 'QUAST' {
        ext.prefix = { "${meta.id}_${meta.stage}_${meta.assembly}" }
    }

    // ---- Purging ----------------------------------------------------------
    withName: 'MINIMAP2_READS' {
        ext.args   = '-x map-hifi'
        ext.prefix = { "${meta.id}_reads" }
    }
    withName: 'MINIMAP2_SELF' {
        ext.args   = '-x asm5 -DP'
        ext.prefix = { "${meta.id}_self" }
    }
    withName: 'PURGEDUPS_GETSEQS' {
        ext.args = '-e'
    }

    // ---- BLAST ------------------------------------------------------------
    withName: 'CONCAT_QUERIES' {
        ext.prefix = { "${meta.id}_queries" }
    }
    withName: 'BLAST_BLASTN' {
        ext.args = "-outfmt '6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore'"
    }

    // ---- Plasmid feature annotation --------------------------------------
    withName: 'PLASMID_EXTRACT_FEATURES' {
        ext.prefix = { "${meta.id}_plasmid" }
    }
    withName: 'PLASMID_BLAST_FEATURES|PLASMID_ANNOTATE_HIT' {
        ext.prefix = { "${meta.id}_${meta.db_type}_${meta.hit_id}" }
    }

    // ---- Read mapping to extracted hit sequences (nxf-minimapper) ---------
    withName: 'MINIMAP2_MAP' {
        ext.args   = '-x map-hifi'
        ext.prefix = { "${meta.id}_${meta.db_type}_${meta.hit_id}" }
    }

    withName: 'MEDAKA_VARIANT|MEDAKA_CONSENSUS|COVERAGE_STATS|CONSENSUS_STATS|IGV_REPORT' {
        ext.prefix = { "${meta.id}_${meta.db_type}_${meta.hit_id}" }
    }

    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }
}
