/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ---- Read QC ----------------------------------------------------------
    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/read_qc/seqkit_stats" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'FASTK_FASTK' {
        ext.args = '-k31'
    }

    withName: '.*:READ_QC:FASTK_HISTEX' {
        ext.prefix = { "${meta.id}" }
        ext.args   = "-G"
        tag        = { "${meta.id}" }
    }

    withName: '.*:READ_QC:GENOMESCOPE2' {
        ext.prefix = { "${meta.id}" }
        ext.args   = {
            [
                "-k31",
                "--json_report"
            ].join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/read_qc/genomescope2/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- Downsampling -----------------------------------------------------
    withName: 'DOWNSAMPLE_SEQKIT' {
        publishDir = [
            path: { "${params.outdir}/downsample/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- Assembly ---------------------------------------------------------
    withName: 'HIFIASM' {
        ext.args = '--primary'
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- Assembly QC ------------------------------------------------------
    withName: 'ASMSTATS' {
        ext.prefix = { "${meta.id}_${meta.stage}_${meta.assembly}" }
        publishDir = [
            path: { "${params.outdir}/assembly_qc/${meta.id}/${meta.stage}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'GFASTATS' {
        ext.prefix = { "${meta.id}_${meta.stage}_${meta.assembly}" }
        publishDir = [
            path: { "${params.outdir}/assembly_qc/${meta.id}/${meta.stage}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BUSCO_BUSCO' {
        ext.prefix = { "${meta.id}_${meta.stage}_${meta.assembly}" }
        publishDir = [
            path: { "${params.outdir}/assembly_qc/${meta.id}/${meta.stage}/busco" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- Purging ----------------------------------------------------------
    withName: 'MINIMAP2_READS' {
        ext.args   = '-x map-hifi'
        ext.prefix = { "${meta.id}_reads" }
    }
    withName: 'MINIMAP2_SELF' {
        ext.args   = '-x asm5 -DP'
        ext.prefix = { "${meta.id}_self" }
    }
    withName: 'PURGEDUPS_GETSEQS' {
        ext.args = '-e'
        publishDir = [
            path: { "${params.outdir}/purging/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- BLAST ------------------------------------------------------------
    withName: 'CONCAT_QUERIES' {
        ext.prefix = { "${meta.id}_queries" }
    }
    withName: 'BLAST_MAKEBLASTDB' {
        publishDir = [
            path: { "${params.outdir}/blast/databases/${meta.id}/${meta.db_type}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BLAST_BLASTN' {
        ext.args = "-outfmt '6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore'"
        publishDir = [
            path: { "${params.outdir}/blast/results/${meta.id}/${meta.db_type}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BLAST_EXTRACT_HITS' {
        publishDir = [
            path: { "${params.outdir}/extracted_sequences/${meta.id}/${meta.db_type}" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- Read mapping to extracted sequences ------------------------------
    withName: 'MINIMAP2_MAP' {
        ext.args   = '-x map-hifi'
        ext.prefix = { "${meta.id}_${meta.db_type}" }
        publishDir = [
            path: { "${params.outdir}/read_mapping/${meta.id}/${meta.db_type}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
