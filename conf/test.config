/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run . -profile test,<docker/singularity> --outdir <OUTDIR>
        nextflow run . -profile test -stub-run --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data (bundled under TESTS/TEST_DATA/)
    input           = "${projectDir}/samplesheet.test.yaml"
    reference       = "${projectDir}/TESTS/TEST_DATA/REFERENCE-ASSEMBLY/GCF_000091205.1_ASM9120v1_genomic.fna.gz"
    blast_queries   = "${projectDir}/TESTS/TEST_DATA/CONSTRUCTS-TO-SEARCH"
    plasmid         = "${projectDir}/TESTS/TEST_DATA/PLASMIDS/cmc_087.gb"

    // Analysis options tuned for the small test dataset
    target_coverage = 60
    busco_lineage   = 'eukaryota_odb10'
}

// The test profile runs locally rather than on the default SLURM executor.
process {
    executor = 'local'
    resourceLimits = [ cpus: 4, memory: '8.GB', time: '1.h' ]
}

executor {
    cpus   = 4
    memory = '8.GB'
}
