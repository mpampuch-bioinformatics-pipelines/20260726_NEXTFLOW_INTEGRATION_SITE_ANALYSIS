nextflow_workflow {

    name "Test Workflow TEST_RENAME_BUSCO_SUMMARY"
    script "modules/local/rename_busco_summary/tests/main.nf"
    workflow "TEST_RENAME_BUSCO_SUMMARY"
    tag "modules"
    tag "modules_local"
    tag "rename_busco_summary"

    test("Should keep primary and alternate BUSCO summaries as different MultiQC names") {
        tag "fast"
        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id: 'sample', stage: 'raw', assembly: 'primary' ],
                        file("${projectDir}/modules/local/rename_busco_summary/fixtures/short_summary.specific.eukaryota_odb10.txt")
                    ],
                    [
                        [ id: 'sample', stage: 'raw', assembly: 'alternate' ],
                        file("${projectDir}/modules/local/rename_busco_summary/fixtures/short_summary.specific.eukaryota_odb10.txt")
                    ]
                )
                """
            }
        }
        then {
            DebugUtils.printTree(workflow.out)
            assert workflow.success
            def names = workflow.out.summary.collect { _meta, summary ->
                new File(summary.toString()).name
            }.sort()
            assert names == [
                'short_summary.specific.eukaryota_odb10.sample_raw_alternate.txt',
                'short_summary.specific.eukaryota_odb10.sample_raw_primary.txt',
            ]
        }
    }

    test("Should copy each auto-lineage short_summary when BUSCO emits two files") {
        tag "fast"
        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id: 'cmc103', stage: 'raw', assembly: 'primary' ],
                        [
                            file("${projectDir}/modules/local/rename_busco_summary/fixtures/short_summary.generic.eukaryota_odb12.assembly.fa.txt"),
                            file("${projectDir}/modules/local/rename_busco_summary/fixtures/short_summary.specific.rhodophyta_odb12.assembly.fa.txt"),
                        ]
                    ]
                )
                """
            }
        }
        then {
            DebugUtils.printTree(workflow.out)
            assert workflow.success
            def names = workflow.out.summary.collectMany { _meta, summary ->
                def files = summary instanceof Collection ? summary : [summary]
                files.collect { new File(it.toString()).name }
            }.sort()
            assert names == [
                'short_summary.generic.eukaryota_odb12.cmc103_raw_primary.txt',
                'short_summary.specific.rhodophyta_odb12.cmc103_raw_primary.txt',
            ]
        }
    }
}
