// Caps for the real caller test on a laptop.
// process_high asks Docker for 72 GB. DeepVariant and the SV alignment run
// together, so two of those limits do not fit even on a 96 GB machine.
process {
    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        cpus   = 4
        memory = 8.GB
    }
    withName: 'MINIMAP2_SV' {
        cpus   = 4
        memory = 8.GB
    }
    withName: 'SNIFFLES' {
        cpus   = 4
        memory = 8.GB
    }
    withName: 'SV_IGV_REPORT' {
        cpus   = 2
        memory = 8.GB
    }
    withName: 'BCFTOOLS_STATS_SMALL' {
        memory = 4.GB
    }
    withName: 'BCFTOOLS_STATS_SV' {
        memory = 4.GB
    }
}
